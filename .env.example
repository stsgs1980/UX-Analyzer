DATABASE_URL="file:./db/dev.db"

# --- AI providers ---
# Primary: Z.ai (config lives in .z-ai-config, not in .env)

# Fallback 1: Groq
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"
# GROQ_API_KEY=

# Fallback 2: any OpenAI-compatible endpoint.
# Works without a key on anonymous providers (e.g. Pollinations).
AI_BASE_URL="https://text.pollinations.ai/openai"
AI_MODEL="openai"
# AI_API_KEY=
# Reasoning models need a budget for thinking, otherwise the answer is cut off.
AI_MAX_TOKENS="8192"
AI_REASONING_EFFORT="low"

# --- Screenshot service ---
# Local Playwright gateway. Leave empty to use thum.io instead.
# SCREENSHOT_SERVICE_BASE_URL="http://localhost:3010"
